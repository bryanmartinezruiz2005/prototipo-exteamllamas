# Entorno: development | production
NODE_ENV=development

# Puerto del servidor
PORT=3000

# Orígenes permitidos para CORS (separados por coma; usar * solo en desarrollo)
CORS_ORIGIN=*

# JWT - autenticación stateless (generar con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))")
JWT_SECRET=reemplaza_esto_con_un_secreto_largo_de_96_hex
JWT_EXPIRES_IN=8h

# Cadena de conexión a PostgreSQL / Supabase
# Opción A: Supabase Pooler (recomendado para conexiones externas)
DATABASE_URL=postgresql://postgres:tu_password@db.tu-proyecto.supabase.co:6543/postgres

# Opción B: Supabase Directo (para ejecuciones locales/largas)
# DATABASE_URL=postgresql://postgres:tu_password@db.tu-proyecto.supabase.co:5432/postgres

# Opción C: PostgreSQL local (desarrollo)
# DATABASE_URL=postgresql://postgres:tu_password@localhost:5432/exteamllamas
